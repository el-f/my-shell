# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use LF
*.sh text eol=lf
*.nu text eol=lf
*.xsh text eol=lf

# Python
*.py text eol=lf

# Config files
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Windows-specific
*.bat text eol=crlf
*.ps1 text eol=crlf
