# my-shell template -- overwritten on update; edit user-env.nu in your nushell config directory instead

# Path Setup

# Set up PATH with common locations
$env.PATH = (
    $env.PATH
    | split row (char esep)
    | prepend (
        if ($nu.os-info.name == "windows") {
            [
                ($env.SystemRoot? | default "C:\\Windows" | path join "System32")
                ($env.SystemRoot? | default "C:\\Windows")
                ($env.ChocolateyInstall? | default "C:\\ProgramData\\chocolatey" | path join "bin")
                ($env.SCOOP? | default ($env.USERPROFILE | path join "scoop") | path join "shims")
                ($env.USERPROFILE | path join "AppData" "Local" "Programs")
                ($env.USERPROFILE | path join "AppData" "Local" "Microsoft" "WindowsApps")
                ($env.USERPROFILE | path join ".cargo" "bin")
                ($env.USERPROFILE | path join ".local" "bin")
            ]
        } else {
            [
                "/usr/local/bin"
                "/usr/bin"
                "/bin"
                "/usr/sbin"
                "/sbin"
                ($env.HOME | path join ".cargo/bin")
                ($env.HOME | path join ".local/bin")
                ($env.HOME | path join "bin")
            ]
        }
    )
)

# Homebrew on macOS (ARM64: /opt/homebrew/bin, Intel: /usr/local/bin)
if ($nu.os-info.name == "macos") {
    for brew_prefix in ["/opt/homebrew/bin", "/usr/local/bin"] {
        if ($brew_prefix | path exists) and ($brew_prefix not-in $env.PATH) {
            $env.PATH = ($env.PATH | prepend $brew_prefix)
        }
    }
}

# Add user-level Python scripts to PATH on Windows (for pip-installed tools)
if ($nu.os-info.name == "windows") {
    let python_root = ($env.APPDATA | path join "Python")
    if ($python_root | path exists) {
        let python_scripts = (
            ls $python_root
            | where type == dir
            | where {|d| ($d.name | path basename | str starts-with "Python") }
            | each {|d| $d.name | path join "Scripts" }
        )
        for p in $python_scripts {
            if ($p | path exists) {
                $env.PATH = ($env.PATH | prepend $p)
            }
        }
    }
}

# Mise (tool version manager)

# Use shims mode -- adds mise-managed tools to PATH
let mise_shims = if ($nu.os-info.name == "windows") {
    ($env.LOCALAPPDATA | path join "mise" "shims")
} else {
    ($env.HOME | path join ".local" "share" "mise" "shims")
}
if ($mise_shims | path exists) {
    $env.PATH = ($env.PATH | prepend $mise_shims)
}

# Environment Variables

# Never override a locale the user already set.
$env.LANG = ($env.LANG? | default "en_US.UTF-8")

# XDG Base Directory Specification (Linux only)
# On macOS, setting XDG_CONFIG_HOME can confuse nushell's config resolution
# (macOS uses ~/Library/Application Support/ by default)
if ($nu.os-info.name == "linux") {
    $env.XDG_CONFIG_HOME = ($env.XDG_CONFIG_HOME? | default ($env.HOME | path join ".config"))
    $env.XDG_DATA_HOME = ($env.XDG_DATA_HOME? | default ($env.HOME | path join ".local/share"))
    $env.XDG_CACHE_HOME = ($env.XDG_CACHE_HOME? | default ($env.HOME | path join ".cache"))
}

# Tool-specific Environment Variables

# FZF default options
$env.FZF_DEFAULT_OPTS = "--height 40% --layout=reverse --border --multi"

# FZF default command (use fd if available)
if (which fd | is-not-empty) {
    $env.FZF_DEFAULT_COMMAND = "fd --type f --hidden --follow --exclude .git"
    $env.FZF_CTRL_T_COMMAND = $env.FZF_DEFAULT_COMMAND
    $env.FZF_ALT_C_COMMAND = "fd --type d --hidden --follow --exclude .git"
}

# Bat (cat replacement) theme and style
$env.BAT_THEME = "Monokai Extended"
$env.BAT_STYLE = "numbers,changes,header,grid"

# Less options (for better man pages)
$env.LESS = "-R"

# Enable color output for various tools
$env.CLICOLOR = "1"

# Ripgrep config file location (only set if it exists)
let rg_config_path = if ($nu.os-info.name == "windows") {
    ($env.USERPROFILE | path join ".ripgreprc")
} else {
    ($env.HOME | path join ".ripgreprc")
}
if ($rg_config_path | path exists) {
    $env.RIPGREP_CONFIG_PATH = $rg_config_path
}

# Development Environment Variables

# Python
$env.PYTHONDONTWRITEBYTECODE = "1"
$env.VIRTUAL_ENV_DISABLE_PROMPT = "1"

# Go
if (which go | is-not-empty) {
    $env.GOPATH = if ($nu.os-info.name == "windows") {
        ($env.USERPROFILE | path join "go")
    } else {
        ($env.HOME | path join "go")
    }

    # Add GOPATH/bin to PATH
    let go_bin = ($env.GOPATH | path join "bin")
    if ($go_bin | path exists) {
        $env.PATH = ($env.PATH | prepend $go_bin)
    }
}

# Rust
if ($nu.os-info.name == "windows") {
    $env.CARGO_HOME = ($env.USERPROFILE | path join ".cargo")
} else {
    $env.CARGO_HOME = ($env.HOME | path join ".cargo")
}
